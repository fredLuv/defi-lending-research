    {
      "start": 0.2,
      "end": 2.8,
      "text": "Is lending digital dollars worth it?",
      "duration_seconds": 2.0,
      "wav_sha256": "b532471923b61dc1b7536092b79ace61987db01781570c590a1d7d3828f6231e"
    },
    {
      "start": 2.9,
      "end": 11.8,
      "text": "These Aave and Morpho products quote higher rates than a short-term Treasury fund. But fees and access to your money matter.",
      "duration_seconds": 7.32,
      "wav_sha256": "8d0c4c8d0e23e38c636538885f71ade675c431367435b811e33427886123272e"
    },
    {
      "start": 12.4,
      "end": 19.9,
      "text": "Over ninety days, Aave earns eleven dollars more than the Treasury fund after fees, if rates hold.",
      "duration_seconds": 6.04,
      "wav_sha256": "7920b7a4f1bd43f102228e5c51d7c1b7f95b7b1b7ed4ecb86c5c1a6aaa7060a4"
    },
    {
      "start": 20.7,
      "end": 30.8,
      "text": "April's example used Aave version three. Today's products are different. Available cash is shared, so immediate withdrawals aren't guaranteed.",
      "duration_seconds": 8.9,
      "wav_sha256": "6b4e88c9e0ef9638fa0add9289bf81f923b36e935fb1e2c958b95bfdd5991d80"
    },
    {
      "start": 32.1,
      "end": 38.0,
      "text": "Better apps should explain earnings after fees, and how easily you can get your money back.",
      "duration_seconds": 4.74,
      "wav_sha256": "b3d87fe4de2efc6a9d760e99f79ad33ee9316a641561705717be560b8b25577e"
