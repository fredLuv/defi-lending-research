    {
      "start": 0.2,
      "end": 2.8,
      "text": "Is stablecoin lending worth it?",
      "duration_seconds": 1.8,
      "wav_sha256": "fbeef2a8f6f11dd7fa78775fd94d672815b03a3064376c1d270b88c830d41c86"
    },
    {
      "start": 2.9,
      "end": 11.8,
      "text": "These Aave and Morpho products quote higher rates than a short-term Treasury fund. But fees and access to your money matter.",
      "duration_seconds": 7.84,
      "wav_sha256": "b9ff3da69f5e4cf687c02f7f5ae994e71c271d364c06f8f1a9ae988f7195755f"
    },
    {
      "start": 12.4,
      "end": 19.9,
      "text": "Over ninety days, Aave earns eleven dollars more than the Treasury fund after fees, if rates hold.",
      "duration_seconds": 6.68,
      "wav_sha256": "731fdf8e0ab3ffe54e6083ed8be922bcd4d98173ee4cc66792e5ac095ff24890"
    },
    {
      "start": 20.7,
      "end": 30.8,
      "text": "April's example used Aave version three. Today's products are different. Available cash is shared, so immediate withdrawals aren't guaranteed.",
      "duration_seconds": 9.6,
      "wav_sha256": "f5e54a744a8260e7f3e757efebc48347301d4211aafd7b5e7db2b41bc9d1f555"
    },
    {
      "start": 32.1,
      "end": 38.0,
      "text": "Better apps should explain earnings after fees, and how easily you can get your money back.",
      "duration_seconds": 5.22,
      "wav_sha256": "c199267f9d62ad5d4fa8318a0a7025ed1ed9e06065aa0b4e6b923808bcf508fe"
