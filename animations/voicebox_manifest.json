      "wav_sha256": "731fdf8e0ab3ffe54e6083ed8be922bcd4d98173ee4cc66792e5ac095ff24890"
    },
    {
      "start": 20.7,
      "end": 30.8,
      "text": "Aave version three had about sixty-five hundred USDC available in April. Today's figures don't guarantee immediate withdrawals.",
      "duration_seconds": 9.54,
      "wav_sha256": "69cb248729eb9eda661a4957ca1cf9615331b462d688dd13c7a344dad6a514f5"
    },
    {
      "start": 32.1,
      "end": 38.0,
      "text": "Fees can erase the extra earnings. Apps should explain costs and withdrawal delays.",
