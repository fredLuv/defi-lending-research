    {
      "start": 0.2,
      "end": 2.8,
      "text": "Is stablecoin lending worth it?",
      "duration_seconds": 1.8,
      "wav_sha256": "fbeef2a8f6f11dd7fa78775fd94d672815b03a3064376c1d270b88c830d41c86"
    },
    {
      "start": 2.9,
      "end": 11.8,
      "text": "These Aave and Morpho products quote higher rates than a short-term Treasury fund. But fees and access to your money matter.",
